# ═══════════════════════════════════════════════════════════════════════════
#  ELEVEN STORE — متغيرات البيئة
# ═══════════════════════════════════════════════════════════════════════════
#  انسخ هذا الملف إلى .env واملأ القيم الفعلية. لا يوجد أي قيمة احتياطية
#  حقيقية في الكود لأي من متغيرات Firebase (fail-fast عمداً — انظر
#  client/src/lib/firebase.ts) — التطبيق لن يعمل بدون ضبطها.
# ═══════════════════════════════════════════════════════════════════════════

# ── السيرفر (Node) ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# محتوى JSON كامل لملف مفتاح خدمة Firebase (Service Account) كسطر واحد
FIREBASE_SERVICE_ACCOUNT=
OWNER_OPEN_ID=
EXTRA_CORS_ORIGIN=
SITE_BASE_URL=

# ── Firebase (واجهة العميل — مشترك بين الموقع والتطبيق) ────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FCM_VAPID_KEY=
VITE_RECAPTCHA_SITE_KEY=

# ── Algolia — البحث ─────────────────────────────────────────────────────
# مفتاح الـAdmin (سيرفر فقط — لا يوضع أبداً بمتغير VITE_* لأنه سيُشحن للمتصفح)
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_PRODUCTS_INDEX=products
# مفتاح Search-Only (آمن للنشر العلني بالواجهة — نفس التطبيق (App ID) أعلاه)
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=
VITE_ALGOLIA_PRODUCTS_INDEX=products

# ── متكاملات أخرى (اختيارية بحسب البيئة) ───────────────────────────────
VITE_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
